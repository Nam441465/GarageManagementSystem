<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.InviteController" prefHeight="420" prefWidth="720">
    <top><VBox alignment="CENTER" spacing="10" style="-fx-padding: 16;"><Label text="Employee Invite Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/><HBox alignment="CENTER" spacing="8"><TextField fx:id="inviteCodeField" promptText="Invite code" prefWidth="300"/><Button text="Generate" onAction="#generateCode"/><Button text="Create" onAction="#createInvite"/><Button text="Delete selected" onAction="#deleteInvite"/><Button text="Back" onAction="#backToDashboard"/></HBox></VBox></top>
    <center><TableView fx:id="inviteTable"><columns><TableColumn fx:id="idColumn" text="ID" prefWidth="70"/><TableColumn fx:id="codeColumn" text="Invite code" prefWidth="250"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/><TableColumn fx:id="createdDateColumn" text="Created date" prefWidth="240"/></columns></TableView></center>
</BorderPane>
