<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.InviteController" prefHeight="420" prefWidth="720">
    <top><VBox alignment="CENTER" spacing="10" style="-fx-padding: 16;"><Label text="Quản lý mã mời nhân viên" style="-fx-font-size: 20px; -fx-font-weight: bold;"/><HBox alignment="CENTER" spacing="8"><TextField fx:id="inviteCodeField" promptText="Mã mời" prefWidth="300"/><Button text="Tạo mã" onAction="#generateCode"/><Button text="Tạo" onAction="#createInvite"/><Button text="Xóa mục đã chọn" onAction="#deleteInvite"/><Button text="Quay lại" onAction="#backToDashboard"/></HBox></VBox></top>
    <center><TableView fx:id="inviteTable"><columns><TableColumn fx:id="idColumn" text="ID" prefWidth="70"/><TableColumn fx:id="codeColumn" text="Mã mời" prefWidth="250"/><TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120"/><TableColumn fx:id="createdDateColumn" text="Ngày tạo" prefWidth="240"/></columns></TableView></center>
</BorderPane>
