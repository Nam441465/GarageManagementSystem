<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.InviteController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox spacing="10"
              style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <VBox spacing="2">
                <Label text="QUẢN LÝ MÃ MỜI NHÂN VIÊN"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                <Label text="Tạo và quản lý mã bảo mật cho phép nhân viên mới đăng ký tài khoản"
                       style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="inviteCodeField"
                           promptText="Nhập hoặc tạo mã mời ngẫu nhiên"
                           HBox.hgrow="ALWAYS"
                           prefHeight="36"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Button text="Tạo ngẫu nhiên"
                        onAction="#generateCode"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-border-color: #9fa8da; -fx-border-radius: 4;" />

                <Button text="Thêm mã mời"
                        onAction="#createInvite"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />

                <Button text="Xóa mã"
                        onAction="#deleteInvite"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;" />

                <Button text="Quay lại"
                        onAction="#backToDashboard"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="inviteTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="Mã số"
                                 prefWidth="70" />
                    <TableColumn fx:id="codeColumn"
                                 text="Mã mời"
                                 prefWidth="320" />
                    <TableColumn fx:id="statusColumn"
                                 text="Trạng thái sử dụng"
                                 prefWidth="180" />
                    <TableColumn fx:id="createdDateColumn"
                                 text="Thời điểm tạo"
                                 prefWidth="220" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
