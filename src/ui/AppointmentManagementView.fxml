<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AppointmentManagementController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox spacing="4"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 15 20 15 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="LỊCH HẸN ĐÃ ĐẶT"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Danh sách lịch hẹn đặt chỗ của khách hàng"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="appointmentTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="Mã số"
                                 prefWidth="50" />
                    <TableColumn fx:id="customerNameColumn"
                                 text="Tên khách hàng"
                                 prefWidth="160" />
                    <TableColumn fx:id="phoneColumn"
                                 text="Số điện thoại"
                                 prefWidth="120" />
                    <TableColumn fx:id="licensePlateColumn"
                                 text="Biển số xe"
                                 prefWidth="110" />
                    <TableColumn fx:id="vehicleBrandColumn"
                                 text="Hãng xe"
                                 prefWidth="110" />
                    <TableColumn fx:id="vehicleTypeColumn"
                                 text="Loại xe"
                                 prefWidth="110" />
                    <TableColumn fx:id="appointmentDateColumn"
                                 text="Ngày"
                                 prefWidth="110" />
                    <TableColumn fx:id="appointmentTimeColumn"
                                 text="Giờ"
                                 prefWidth="90" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="16"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 12 20 15 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <Button text="Làm mới"
                    prefWidth="130"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-cursor: hand;"
                    onAction="#refreshAppointments" />

            <Button text="Xóa lịch"
                    prefWidth="130"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-cursor: hand; -fx-text-fill: #c62828;"
                    onAction="#deleteAppointment" />

            <Button text="Quay lại"
                    prefWidth="130"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-cursor: hand;"
                    onAction="#backToDashboard" />

        </HBox>
    </bottom>

</BorderPane>
