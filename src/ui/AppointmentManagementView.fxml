<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AppointmentManagementController">

    <top>

        <VBox spacing="8"
              alignment="CENTER"
              style="-fx-padding:20;">

            <Label text="LỊCH HẸN ĐÃ ĐẶT"
                   style="
                   -fx-font-size:24px;
                   -fx-font-weight:bold;" />

            <Label text="Danh sách lịch hẹn của khách hàng"
                   style="-fx-font-size:14px;" />

        </VBox>

    </top>


    <center>

        <TableView fx:id="appointmentTable">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="60"/>

                <TableColumn fx:id="customerNameColumn"
                             text="Tên khách hàng"
                             prefWidth="150"/>

                <TableColumn fx:id="phoneColumn"
                             text="Số điện thoại"
                             prefWidth="120"/>

                <TableColumn fx:id="licensePlateColumn"
                             text="Biển số"
                             prefWidth="100"/>

                <TableColumn fx:id="vehicleBrandColumn"
                             text="Hãng xe"
                             prefWidth="100"/>

                <TableColumn fx:id="vehicleTypeColumn"
                             text="Loại xe"
                             prefWidth="110"/>

                <TableColumn fx:id="appointmentDateColumn"
                             text="Ngày"
                             prefWidth="110"/>

                <TableColumn fx:id="appointmentTimeColumn"
                             text="Giờ"
                             prefWidth="80"/>

            </columns>

        </TableView>

    </center>


    <bottom>

        <HBox spacing="15"
              alignment="CENTER"
              style="-fx-padding:15;">

            <Button text="Làm mới"
                    prefWidth="120"
                    onAction="#refreshAppointments"/>

            <Button text="Xóa lịch"
                    prefWidth="120"
                    onAction="#deleteAppointment"/>

            <Button text="Quay lại"
                    prefWidth="120"
                    onAction="#backToDashboard"/>

        </HBox>

    </bottom>

</BorderPane>