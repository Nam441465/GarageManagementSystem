<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.StatisticsController" alignment="CENTER" spacing="12" prefHeight="420" prefWidth="500" style="-fx-padding: 24;">
    <Label text="Garage Statistics" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <GridPane hgap="20" vgap="12"><Label text="Customers:" GridPane.rowIndex="0" GridPane.columnIndex="0"/><Label fx:id="customerCountLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/><Label text="Vehicles:" GridPane.rowIndex="1" GridPane.columnIndex="0"/><Label fx:id="vehicleCountLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/><Label text="Services:" GridPane.rowIndex="2" GridPane.columnIndex="0"/><Label fx:id="serviceCountLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/><Label text="Employees:" GridPane.rowIndex="3" GridPane.columnIndex="0"/><Label fx:id="employeeCountLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/><Label text="Service records:" GridPane.rowIndex="4" GridPane.columnIndex="0"/><Label fx:id="recordCountLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/><Label text="Invoices:" GridPane.rowIndex="5" GridPane.columnIndex="0"/><Label fx:id="invoiceCountLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/><Label text="Total revenue:" GridPane.rowIndex="6" GridPane.columnIndex="0"/><Label fx:id="revenueLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/></GridPane>
    <HBox alignment="CENTER" spacing="10"><Button text="Refresh" onAction="#refresh"/><Button text="Back" onAction="#backToDashboard"/></HBox>
</VBox>
