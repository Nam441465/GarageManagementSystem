<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="controller.StatisticsController"
    alignment="CENTER"
    spacing="12"
    prefHeight="380"
    prefWidth="500"
    style="-fx-padding: 24;">

    <Label text="Thống kê gara"
        style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <GridPane hgap="20"
        vgap="12">

        <Label text="Khách hàng:"
            GridPane.rowIndex="0"
            GridPane.columnIndex="0" />

        <Label fx:id="customerCountLabel"
            GridPane.rowIndex="0"
            GridPane.columnIndex="1" />


        <Label text="Xe:"
            GridPane.rowIndex="1"
            GridPane.columnIndex="0" />

        <Label fx:id="vehicleCountLabel"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1" />


        <Label text="Dịch vụ:"
            GridPane.rowIndex="2"
            GridPane.columnIndex="0" />

        <Label fx:id="serviceCountLabel"
            GridPane.rowIndex="2"
            GridPane.columnIndex="1" />


        <Label text="Nhân viên:"
            GridPane.rowIndex="3"
            GridPane.columnIndex="0" />

        <Label fx:id="employeeCountLabel"
            GridPane.rowIndex="3"
            GridPane.columnIndex="1" />


        <Label text="Hóa đơn:"
            GridPane.rowIndex="4"
            GridPane.columnIndex="0" />

        <Label fx:id="invoiceCountLabel"
            GridPane.rowIndex="4"
            GridPane.columnIndex="1" />


        <Label text="Tổng doanh thu:"
            GridPane.rowIndex="5"
            GridPane.columnIndex="0" />

        <Label fx:id="revenueLabel"
            GridPane.rowIndex="5"
            GridPane.columnIndex="1" />

    </GridPane>

    <HBox alignment="CENTER"
        spacing="10">

        <TextField fx:id="outputDirectoryField"
            text="exports"
            promptText="Thư mục xuất PDF" />

        <Button text="Xuất PDF"
            onAction="#exportPdf" />

        <Button text="Làm mới"
            onAction="#refresh" />

        <Button text="Quay lại"
            onAction="#backToDashboard" />

    </HBox>

</VBox>