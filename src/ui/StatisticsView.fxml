<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.StatisticsController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox spacing="4"
              alignment="CENTER"
              style="-fx-background-color: #1a237e; -fx-padding: 16 25 16 25;">
            <Label text="BÁO CÁO THỐNG KÊ HOẠT ĐỘNG GARA"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
            <Label text="Tổng hợp dữ liệu kinh doanh, số lượng xe, khách hàng và tổng doanh thu"
                   style="-fx-font-size: 13px; -fx-text-fill: #e8eaf6;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-padding: 20 30 20 30;"
                  alignment="CENTER"
                  VBox.vgrow="ALWAYS">

                <GridPane hgap="20"
                          vgap="20"
                          maxWidth="Infinity"
                          VBox.vgrow="ALWAYS"
                          alignment="CENTER">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="120" prefHeight="140" vgrow="ALWAYS" />
                        <RowConstraints minHeight="120" prefHeight="140" vgrow="ALWAYS" />
                    </rowConstraints>

                    <!-- Khách hàng -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #90caf9; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="TỔNG SỐ KHÁCH HÀNG"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                        <Label fx:id="customerCountLabel"
                               text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;" />
                        <Label text="Khách hàng đã đăng ký"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                    <!-- Phương tiện -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #80cbc4; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="TỔNG SỐ XE ĐÃ TIẾP NHẬN"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #00695c;" />
                        <Label fx:id="vehicleCountLabel"
                               text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #004d40;" />
                        <Label text="Phương tiện trong gara"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                    <!-- Dịch vụ -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="0"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ffb74d; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="GÓI DỊCH VỤ HIỆN CÓ"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e65100;" />
                        <Label fx:id="serviceCountLabel"
                               text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #bf360c;" />
                        <Label text="Dịch vụ niêm yết"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                    <!-- Nhân viên -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #ce93d8; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="ĐỘI NGŨ NHÂN SỰ"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4a148c;" />
                        <Label fx:id="employeeCountLabel"
                               text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #311b92;" />
                        <Label text="Kỹ thuật viên &amp; Cố vấn"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                    <!-- Hóa đơn -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81d4fa; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="TỔNG SỐ HÓA ĐƠN"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #01579b;" />
                        <Label fx:id="invoiceCountLabel"
                               text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #01579b;" />
                        <Label text="Hóa đơn thanh toán"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                    <!-- Doanh thu -->
                    <VBox alignment="CENTER"
                          spacing="8"
                          GridPane.columnIndex="2"
                          GridPane.rowIndex="1"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #a5d6a7; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                        <Label text="TỔNG DOANH THU"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />
                        <Label fx:id="revenueLabel"
                               text="0 VNĐ"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" />
                        <Label text="Đã thanh toán thực tế"
                               style="-fx-font-size: 12px; -fx-text-fill: #546e7a;" />
                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="16"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 12 25 15 25; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <TextField fx:id="outputDirectoryField"
                       text="exports"
                       promptText="Thư mục xuất file"
                       prefWidth="160"
                       prefHeight="36"
                       style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

            <Button text="Xuất Báo Cáo PDF"
                    prefWidth="160"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;"
                    onAction="#exportPdf" />

            <Button text="Làm mới số liệu"
                    prefWidth="140"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-border-color: #9fa8da; -fx-border-radius: 4;"
                    onAction="#refresh" />

            <Button text="Quay lại Bảng điều khiển"
                    prefWidth="190"
                    prefHeight="36"
                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;"
                    onAction="#backToDashboard" />

        </HBox>
    </bottom>

</BorderPane>
