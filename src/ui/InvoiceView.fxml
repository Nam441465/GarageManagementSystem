<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.InvoiceController">

    <top>
        <Label text="Invoice Management"/>
    </top>

    <center>

        <TableView fx:id="invoiceTable">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"/>

                <TableColumn fx:id="recordIdColumn"
                             text="Record ID"/>

                <TableColumn fx:id="totalAmountColumn"
                             text="Total Amount"/>

                <TableColumn fx:id="issueDateColumn"
                             text="Issue Date"/>

            </columns>

        </TableView>

    </center>

    <right>

        <VBox spacing="10">

            <TextField fx:id="recordIdField"
                       promptText="Record ID"/>

            <TextField fx:id="totalAmountField"
                       promptText="Total Amount"/>

            <TextField fx:id="outputDirectoryField"
                       text="exports"
                       promptText="PDF output directory"/>

            <Button text="Add"
                    onAction="#addInvoice"/>

            <Button text="Update"
                    onAction="#updateInvoice"/>

            <Button text="Delete"
                    onAction="#deleteInvoice"/>

            <Button text="Export PDF"
                    onAction="#exportInvoicePdf"/>
            <Button text="Back" onAction="#backToDashboard"/>

        </VBox>

    </right>

</BorderPane>
