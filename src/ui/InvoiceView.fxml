<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="controller.InvoiceController">

    <top>
        <Label text="Quản lý hóa đơn" />
    </top>

    <center>

        <TableView fx:id="invoiceTable">

            <columns>

                <TableColumn fx:id="idColumn"
                    text="ID" />

                <TableColumn fx:id="customerIdColumn"
                    text="Mã khách hàng" />

                <TableColumn fx:id="employeeIdColumn"
                    text="Mã nhân viên" />

                <TableColumn fx:id="licensePlateColumn"
                    text="Biển số" />

                <TableColumn fx:id="vehicleTypeColumn"
                    text="Loại xe" />

                <TableColumn fx:id="vehicleBrandColumn"
                    text="Hãng xe" />

                <TableColumn fx:id="totalAmountColumn"
                    text="Tổng tiền" />

                <TableColumn fx:id="issueDateColumn"
                    text="Ngày lập" />

                <TableColumn fx:id="paymentStatusColumn"
                    text="Trạng thái thanh toán" />

            </columns>

        </TableView>

    </center>

    <right>

        <VBox spacing="10">

            <Label text="Thông tin hóa đơn" />

            <TextField fx:id="customerIdField"
                promptText="Mã khách hàng" />

            <TextField fx:id="licensePlateField"
                promptText="Biển số xe" />

            <ComboBox fx:id="vehicleTypeComboBox"
                promptText="Loại xe" />

            <ComboBox fx:id="vehicleBrandComboBox"
                promptText="Hãng xe" />

            <Label text="Chọn dịch vụ" />

            <ScrollPane fitToWidth="true"
                prefHeight="150">

                <content>

                    <VBox fx:id="serviceCheckBoxContainer"
                        spacing="5" />

                </content>

            </ScrollPane>

            <ComboBox fx:id="paymentStatusComboBox"
                promptText="Trạng thái thanh toán" />

            <TextField fx:id="outputDirectoryField"
                text="exports"
                promptText="Thư mục xuất PDF" />

            <Button text="Thêm"
                onAction="#addInvoice" />

            <Button text="Xóa"
                onAction="#deleteInvoice" />

            <Button text="Xuất PDF"
                onAction="#exportInvoicePdf" />

            <Button text="Làm mới"
                onAction="#clearFields" />

            <Button text="Quay lại"
                onAction="#backToDashboard" />

        </VBox>

    </right>

</BorderPane>