<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="controller.DashboardController">

        <top>

                <VBox spacing="10"
                        alignment="CENTER"
                        style="-fx-padding:20;">

                        <Label text="GARAGE MANAGEMENT SYSTEM"
                                style="
                   -fx-font-size:24px;
                   -fx-font-weight:bold;
                   " />

                        <Label fx:id="welcomeLabel"
                                text="Welcome"
                                style="
                   -fx-font-size:16px;
                   " />

                        <Label fx:id="roleLabel"
                                text="Role"
                                style="
                   -fx-font-size:14px;
                   " />

                </VBox>

        </top>

        <center>

                <VBox spacing="15"
                        alignment="CENTER">

                        <Button fx:id="customerButton"
                                text="Customer Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showCustomer" />

                        <Button fx:id="vehicleButton"
                                text="Vehicle Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showVehicle" />

                        <Button fx:id="serviceButton"
                                text="Service Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showService" />

                        <Button fx:id="serviceRecordButton"
                                text="Service Record Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showServiceRecord" />

                        <Button fx:id="serviceRecordDetailButton"
                                text="Service Record Details"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showServiceRecordDetails" />

                        <Button fx:id="invoiceButton"
                                text="Invoice Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showInvoice" />

                        <Button fx:id="employeeButton"
                                text="Employee Management"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showEmployee" />

                        <Button fx:id="inviteButton"
                                text="Employee Invites"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showInviteManagement" />

                        <Button fx:id="statisticsButton"
                                text="Statistics"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showStatistics" />

                </VBox>

        </center>

        <bottom>

                <HBox spacing="20"
                        alignment="CENTER"
                        style="-fx-padding:20;">

                        <Button fx:id="backButton"
                                text="Back"
                                prefWidth="120"
                                onAction="#back" />

                        <Button fx:id="logoutButton"
                                text="Logout"
                                prefWidth="120"
                                onAction="#logout" />

                </HBox>

        </bottom>

</BorderPane>
