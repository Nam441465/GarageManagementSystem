<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="controller.DashboardController">

        <top>

                <VBox spacing="10"
                        alignment="CENTER"
                        style="-fx-padding:20;">

                        <Label text="HỆ THỐNG QUẢN LÝ GARA"
                                style="
                   -fx-font-size:24px;
                   -fx-font-weight:bold;
                   " />

                        <Label fx:id="welcomeLabel"
                                text="Chào mừng"
                                style="
                   -fx-font-size:16px;
                   " />

                        <Label fx:id="roleLabel"
                                text="Vai trò"
                                style="
                   -fx-font-size:14px;
                   " />

                </VBox>

        </top>

        <center>

                <VBox spacing="15"
                        alignment="CENTER">

                        <Button fx:id="customerButton"
                                text="Quản lý khách hàng"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showCustomer" />

                        <Button fx:id="vehicleButton"
                                text="Quản lý xe"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showVehicle" />

                        <Button fx:id="serviceButton"
                                text="Quản lý dịch vụ"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showService" />

                        <Button fx:id="priceButton"
                                text="Quản lý bảng giá"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showPriceList" />

                        <Button fx:id="appointmentButton"
                                text="Quản lý lịch hẹn"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showAppointment" />

                        <Button fx:id="inventoryButton"
                                text="Quản lý kho phụ tùng"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showInventory" />

                        <Button fx:id="warrantyButton"
                                text="Quản lý bảo hành"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showWarranty" />

                        <Button fx:id="invoiceButton"
                                text="Quản lý hóa đơn"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showInvoice" />

                        <Button fx:id="employeeButton"
                                text="Quản lý nhân viên"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showEmployee" />

                        <Button fx:id="inviteButton"
                                text="Quản lý mã mời nhân viên"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showInviteManagement" />

                        <Button fx:id="statisticsButton"
                                text="Thống kê"
                                prefWidth="300"
                                prefHeight="40"
                                onAction="#showStatistics" />

                </VBox>

        </center>

        <bottom>

                <HBox spacing="20"
                        alignment="CENTER"
                        style="-fx-padding:20;">

                        <Button fx:id="backButton"
                                text="Quay lại"
                                prefWidth="120"
                                onAction="#back" />

                        <Button fx:id="logoutButton"
                                text="Đăng xuất"
                                prefWidth="120"
                                onAction="#logout" />

                </HBox>

        </bottom>

</BorderPane>
