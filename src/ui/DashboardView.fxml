<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox spacing="6"
              alignment="CENTER"
              style="-fx-background-color: #1a237e; -fx-padding: 16 25 16 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 3);">

            <Label text="BẢNG ĐIỀU KHIỂN TRUNG TÂM - HỆ THỐNG GARA"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />

            <HBox alignment="CENTER" spacing="20">
                <Label fx:id="welcomeLabel"
                       text="Chào mừng"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #a5d6a7;" />

                <Label text="|"
                       style="-fx-font-size: 14px; -fx-text-fill: #9fa8da;" />

                <Label fx:id="roleLabel"
                       text="Vai trò"
                       style="-fx-font-size: 14px; -fx-text-fill: #e8eaf6;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-padding: 20 25 20 25;"
                  alignment="CENTER"
                  VBox.vgrow="ALWAYS">

                <GridPane hgap="18"
                          vgap="18"
                          alignment="CENTER"
                          VBox.vgrow="ALWAYS"
                          maxWidth="Infinity">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="65" prefHeight="90" vgrow="ALWAYS" />
                        <RowConstraints minHeight="65" prefHeight="90" vgrow="ALWAYS" />
                        <RowConstraints minHeight="65" prefHeight="90" vgrow="ALWAYS" />
                    </rowConstraints>

                    <!-- Row 0 -->
                    <Button fx:id="customerButton"
                            text="Quản lý khách hàng"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showCustomer" />

                    <Button fx:id="vehicleButton"
                            text="Quản lý xe"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showVehicle" />

                    <Button fx:id="serviceButton"
                            text="Quản lý dịch vụ"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showService" />

                    <Button fx:id="priceButton"
                            text="Quản lý bảng giá"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showPriceList" />

                    <!-- Row 1 -->
                    <Button fx:id="appointmentButton"
                            text="Quản lý lịch hẹn"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showAppointment" />

                    <Button fx:id="inventoryButton"
                            text="Quản lý kho phụ tùng"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showInventory" />

                    <Button fx:id="warrantyButton"
                            text="Quản lý bảo hành"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showWarranty" />

                    <Button fx:id="invoiceButton"
                            text="Quản lý hóa đơn"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showInvoice" />

                    <!-- Row 2 -->
                    <Button fx:id="employeeButton"
                            text="Quản lý nhân viên"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showEmployee" />

                    <Button fx:id="inviteButton"
                            text="Quản lý mã mời"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showInviteManagement" />

                    <Button fx:id="statisticsButton"
                            text="Thống kê báo cáo"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffffff; -fx-text-fill: #1a237e; -fx-border-color: #cfd8dc; -fx-border-radius: 8; -fx-background-radius: 8;"
                            onAction="#showStatistics" />

                    <!-- Ô phụ căn chỉnh -->
                    <VBox alignment="CENTER"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="2"
                          style="-fx-background-color: #e8eaf6; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8;">
                        <Label text="HỆ THỐNG GARA"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                        <Label text="Sẵn sàng hoạt động"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3949ab;" />
                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="25"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 14 30 16 30; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <Button fx:id="backButton"
                    text="Quay lại Đăng nhập"
                    prefWidth="200"
                    prefHeight="40"
                    style="-fx-font-size: 14px; -fx-cursor: hand; -fx-text-fill: #263238;"
                    onAction="#back" />

            <Button fx:id="logoutButton"
                    text="Đăng xuất khỏi hệ thống"
                    prefWidth="200"
                    prefHeight="40"
                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;"
                    onAction="#logout" />

        </HBox>
    </bottom>

</BorderPane>
