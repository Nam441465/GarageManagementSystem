<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.RegisterController" alignment="CENTER" spacing="10" prefHeight="500" prefWidth="420" style="-fx-padding: 24;">
    <Label text="Employee Account Registration" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <TextField fx:id="inviteCodeField" promptText="Invite code" maxWidth="300"/>
    <TextField fx:id="usernameField" promptText="Username" maxWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"/>
    <HBox alignment="CENTER" spacing="10"><Button text="Register" onAction="#register"/><Button text="Back" onAction="#goBack"/></HBox>
</VBox>
