<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.RegisterController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox alignment="CENTER"
              spacing="8"
              style="-fx-background-color: #1a237e; -fx-padding: 25 20 25 20;">
            <Label text="HỆ THỐNG QUẢN LÝ GARA"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
            <Label text="Đăng ký tài khoản nhân viên mới thông qua mã mời"
                   style="-fx-font-size: 14px; -fx-text-fill: #e8eaf6;" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="20"
              style="-fx-padding: 30;"
              VBox.vgrow="ALWAYS">

            <VBox alignment="CENTER"
                  spacing="20"
                  maxWidth="560"
                  style="-fx-background-color: #ffffff; -fx-padding: 40; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #cfd8dc; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);"
                  VBox.vgrow="ALWAYS">

                <Label text="ĐĂNG KÝ NHÂN VIÊN"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                <VBox spacing="12" maxWidth="Infinity">
                    <Label text="Mã mời (được cấp bởi Chủ gara):"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="inviteCodeField"
                               promptText="Nhập mã mời nhân viên"
                               maxWidth="Infinity"
                               prefHeight="42"
                               style="-fx-font-size: 14px;" />

                    <Label text="Tên đăng nhập mong muốn:"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="usernameField"
                               promptText="Nhập tên tài khoản"
                               maxWidth="Infinity"
                               prefHeight="42"
                               style="-fx-font-size: 14px;" />

                    <Label text="Mật khẩu:"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <PasswordField fx:id="passwordField"
                                   promptText="Nhập mật khẩu"
                                   maxWidth="Infinity"
                                   prefHeight="42"
                                   style="-fx-font-size: 14px;" />
                </VBox>

                <HBox spacing="14" maxWidth="Infinity">
                    <Button text="Đăng ký tài khoản"
                            onAction="#register"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="46"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: white; -fx-background-radius: 6;" />

                    <Button text="Quay lại Đăng nhập"
                            onAction="#goBack"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="46"
                            style="-fx-font-size: 14px; -fx-cursor: hand;" />
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
