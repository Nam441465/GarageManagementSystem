<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.WarrantyController">
    <top><Label text="Quản lý bảo hành" style="-fx-font-size: 20px; -fx-padding: 12;"/></top>
    <center><TableView fx:id="warrantyTable"><columns><TableColumn fx:id="idColumn" text="ID" prefWidth="50"/><TableColumn fx:id="invoiceColumn" text="Mã hóa đơn" prefWidth="120"/><TableColumn fx:id="codeColumn" text="Mã bảo hành" prefWidth="130"/><TableColumn fx:id="startColumn" text="Ngày bắt đầu" prefWidth="110"/><TableColumn fx:id="endColumn" text="Ngày kết thúc" prefWidth="110"/><TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="90"/></columns></TableView></center>
    <right><VBox spacing="8" prefWidth="250" style="-fx-padding: 12;"><TextField fx:id="invoiceIdField" promptText="Mã hóa đơn"/><TextField fx:id="warrantyCodeField" promptText="Mã bảo hành"/><DatePicker fx:id="startDatePicker" promptText="Ngày bắt đầu"/><DatePicker fx:id="endDatePicker" promptText="Ngày kết thúc"/><ComboBox fx:id="statusComboBox" promptText="Trạng thái"/><TextArea fx:id="coverageArea" promptText="Phạm vi bảo hành" prefRowCount="4"/><HBox spacing="8"><Button text="Thêm" onAction="#addWarranty"/><Button text="Cập nhật" onAction="#updateWarranty"/></HBox><HBox spacing="8"><Button text="Xóa" onAction="#deleteWarranty"/><Button text="Xóa trắng" onAction="#clearForm"/></HBox><Button text="Quay lại" onAction="#backToDashboard"/></VBox></right>
</BorderPane>
