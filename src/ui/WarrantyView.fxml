<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.WarrantyController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ PHIẾU BẢO HÀNH"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Theo dõi và quản lý phiếu bảo hành dịch vụ, phụ tùng sau sửa chữa"
                   style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="warrantyTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="Mã số"
                                 prefWidth="50" />
                    <TableColumn fx:id="invoiceColumn"
                                 text="Mã hóa đơn"
                                 prefWidth="120" />
                    <TableColumn fx:id="codeColumn"
                                 text="Mã bảo hành"
                                 prefWidth="140" />
                    <TableColumn fx:id="startColumn"
                                 text="Ngày bắt đầu"
                                 prefWidth="120" />
                    <TableColumn fx:id="endColumn"
                                 text="Ngày kết thúc"
                                 prefWidth="120" />
                    <TableColumn fx:id="statusColumn"
                                 text="Trạng thái"
                                 prefWidth="100" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true"
                    prefWidth="350"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
            <VBox spacing="8"
                  style="-fx-padding: 14 16 18 16;">

                <Label text="Thông tin phiếu bảo hành"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                <VBox spacing="5">
                    <Label text="Mã hóa đơn (Invoice ID):" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="invoiceIdField"
                               promptText="Nhập mã hóa đơn"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Mã bảo hành:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="warrantyCodeField"
                               promptText="VD: BH-2026-001"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Ngày bắt đầu bảo hành:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <DatePicker fx:id="startDatePicker"
                                promptText="Chọn ngày bắt đầu"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px;" />

                    <Label text="Ngày kết thúc bảo hành:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <DatePicker fx:id="endDatePicker"
                                promptText="Chọn ngày hết hạn"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px;" />

                    <Label text="Trạng thái bảo hành:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <ComboBox fx:id="statusComboBox"
                              promptText="Chọn trạng thái"
                              maxWidth="Infinity"
                              prefHeight="32"
                              style="-fx-font-size: 13px;" />

                    <Label text="Phạm vi bảo hành:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextArea fx:id="coverageArea"
                              promptText="Mô tả các hạng mục được bảo hành"
                              prefRowCount="2"
                              maxWidth="Infinity"
                              style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />
                </VBox>

                <Separator />

                <VBox spacing="6">
                    <HBox spacing="6">
                        <Button text="Thêm mới"
                                onAction="#addWarranty"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />

                        <Button text="Cập nhật"
                                onAction="#updateWarranty"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa"
                                onAction="#deleteWarranty"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;" />

                        <Button text="Xóa trắng"
                                onAction="#clearForm"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-border-color: #9fa8da; -fx-border-radius: 4;" />
                    </HBox>

                    <Button text="Quay lại"
                            onAction="#backToDashboard"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;" />
                </VBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
