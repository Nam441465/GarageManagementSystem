<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerLookupController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox spacing="6"
              alignment="CENTER"
              style="-fx-background-color: #1a237e; -fx-padding: 16 25 16 25;">
            <Label text="TRA CỨU DỊCH VỤ, BẢNG GIÁ &amp; TIẾN ĐỘ SỬA CHỮA"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
            <Label text="Hệ thống tra cứu trực tuyến dành cho khách hàng gara"
                   style="-fx-font-size: 13px; -fx-text-fill: #e8eaf6;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-padding: 18 25 18 25;"
                  spacing="15"
                  VBox.vgrow="ALWAYS">

                <GridPane hgap="20"
                          vgap="15"
                          maxWidth="Infinity"
                          VBox.vgrow="ALWAYS">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="60" />
                        <ColumnConstraints percentWidth="40" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints percentHeight="100" />
                    </rowConstraints>

                    <!-- Khối 1: Tra cứu dịch vụ & giá -->
                    <VBox spacing="12"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          style="-fx-background-color: #ffffff; -fx-padding: 18; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cfd8dc;"
                          VBox.vgrow="ALWAYS">

                        <Label text="1. TRA CỨU DỊCH VỤ VÀ BẢNG GIÁ"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                        <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
                            <ComboBox fx:id="vehicleTypeComboBox"
                                      promptText="Chọn loại xe"
                                      HBox.hgrow="ALWAYS"
                                      maxWidth="Infinity"
                                      prefHeight="36"
                                      style="-fx-font-size: 13px;" />

                            <ComboBox fx:id="vehicleBrandComboBox"
                                      promptText="Chọn hãng xe"
                                      HBox.hgrow="ALWAYS"
                                      maxWidth="Infinity"
                                      prefHeight="36"
                                      style="-fx-font-size: 13px;" />

                            <Button text="Tra cứu giá"
                                    prefWidth="140"
                                    prefHeight="36"
                                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: white; -fx-background-radius: 6;"
                                    onAction="#searchServices" />
                        </HBox>

                        <TextArea fx:id="serviceResultArea"
                                  editable="false"
                                  wrapText="true"
                                  maxWidth="Infinity"
                                  prefRowCount="6"
                                  VBox.vgrow="ALWAYS"
                                  style="-fx-font-size: 13px; -fx-font-family: monospace; -fx-text-fill: #0d47a1; -fx-control-inner-background: #f8f9fa;" />
                    </VBox>

                    <!-- Khối 2: Tra cứu tình trạng xe -->
                    <VBox spacing="12"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          style="-fx-background-color: #ffffff; -fx-padding: 18; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cfd8dc;"
                          VBox.vgrow="ALWAYS">

                        <Label text="2. TRA CỨU TÌNH TRẠNG XE"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                        <VBox spacing="8">
                            <TextField fx:id="licensePlateField"
                                       promptText="Nhập biển số xe (VD: 29A-123.45)"
                                       maxWidth="Infinity"
                                       prefHeight="36"
                                       style="-fx-font-size: 13px; -fx-text-fill: #263238;" />

                            <Button text="Tra cứu tình trạng"
                                    maxWidth="Infinity"
                                    prefHeight="36"
                                    style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: white; -fx-background-radius: 6;"
                                    onAction="#searchVehicle" />
                        </VBox>

                        <Label fx:id="vehicleResultLabel"
                               text="Nhập biển số xe để tra cứu thông tin trạng thái xe trong gara."
                               wrapText="true"
                               maxWidth="Infinity"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0d47a1; -fx-line-spacing: 4px; -fx-padding: 14; -fx-background-color: #e8eaf6; -fx-background-radius: 6; -fx-border-color: #9fa8da; -fx-border-radius: 6; -fx-border-width: 1.5;" />
                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="16"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 12 25 15 25; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <Button text="Quay lại Trang chủ"
                    prefWidth="180"
                    prefHeight="38"
                    style="-fx-font-size: 13px; -fx-cursor: hand; -fx-text-fill: #263238;"
                    onAction="#backToHome" />

        </HBox>
    </bottom>

</BorderPane>
