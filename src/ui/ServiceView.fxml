<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="controller.ServiceController">

    <top>
        <Label text="Quản lý dịch vụ"
            style="-fx-font-size: 20px; -fx-padding: 12px;" />
    </top>

    <center>
        <TableView fx:id="serviceTable">
            <columns>

                <TableColumn fx:id="idColumn"
                    text="ID"
                    prefWidth="70" />

                <TableColumn fx:id="serviceNameColumn"
                    text="Tên dịch vụ"
                    prefWidth="180" />

                <TableColumn fx:id="descriptionColumn"
                    text="Mô tả"
                    prefWidth="300" />

            </columns>
        </TableView>
    </center>

    <right>
        <VBox spacing="10"
            prefWidth="250"
            style="-fx-padding: 15px;">

            <Label text="Thông tin dịch vụ"
                style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <TextField fx:id="serviceNameField"
                promptText="Tên dịch vụ"
                maxWidth="Infinity" />

            <TextField fx:id="descriptionField"
                promptText="Mô tả"
                maxWidth="Infinity" />

            <Button text="Thêm"
                onAction="#addService"
                maxWidth="Infinity" />

            <Button text="Cập nhật"
                onAction="#updateService"
                maxWidth="Infinity" />

            <Button text="Xóa"
                onAction="#deleteService"
                maxWidth="Infinity" />

            <Button text="Quay lại"
                onAction="#backToDashboard"
                maxWidth="Infinity" />

        </VBox>
    </right>

</BorderPane>
