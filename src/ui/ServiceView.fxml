<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServiceController">

    <top>
        <Label text="Service Management"/>
    </top>

    <center>

        <TableView fx:id="serviceTable">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"/>

                <TableColumn fx:id="serviceNameColumn"
                             text="Service Name"/>

                <TableColumn fx:id="priceColumn"
                             text="Price"/>

                <TableColumn fx:id="descriptionColumn"
                             text="Description"/>

            </columns>

        </TableView>

    </center>

    <right>

        <VBox spacing="10">

            <TextField fx:id="serviceNameField"
                       promptText="Service Name"/>

            <TextField fx:id="priceField"
                       promptText="Price"/>

            <TextField fx:id="descriptionField"
                       promptText="Description"/>

            <Button text="Add"
                    onAction="#addService"/>

            <Button text="Update"
                    onAction="#updateService"/>

            <Button text="Delete"
                    onAction="#deleteService"/>
            <Button text="Back" onAction="#backToDashboard"/>

        </VBox>

    </right>

</BorderPane>
