<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.EmployeeController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ NHÂN SỰ GARA"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Quản lý thông tin nhân viên kỹ thuật, cố vấn dịch vụ và mức lương"
                   style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="employeeTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="50" />
                    <TableColumn fx:id="nameColumn"
                                 text="Họ và tên"
                                 prefWidth="200" />
                    <TableColumn fx:id="phoneColumn"
                                 text="Số điện thoại"
                                 prefWidth="130" />
                    <TableColumn fx:id="positionColumn"
                                 text="Chức vụ / Vị trí"
                                 prefWidth="150" />
                    <TableColumn fx:id="salaryColumn"
                                 text="Mức lương cứng (VNĐ)"
                                 prefWidth="160" />
                    <TableColumn fx:id="userIdColumn"
                                 text="User ID"
                                 prefWidth="80" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="8"
              prefWidth="340"
              style="-fx-background-color: #ffffff; -fx-padding: 14 18 16 18; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">

            <Label text="Thông tin nhân sự"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

            <VBox spacing="5">
                <Label text="Họ và tên:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="nameField"
                           promptText="Nhập tên nhân viên"
                           prefHeight="32"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Số điện thoại:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="phoneField"
                           promptText="Nhập số điện thoại"
                           prefHeight="32"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Chức vụ:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="positionField"
                           promptText="VD: Kỹ thuật viên chính"
                           prefHeight="32"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Mức lương (VNĐ):" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="salaryField"
                           promptText="VD: 12000000"
                           prefHeight="32"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Tài khoản liên kết (User ID):" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="userIdField"
                           promptText="Mã tài khoản đăng nhập"
                           prefHeight="32"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />
            </VBox>

            <Separator />

            <VBox spacing="6">
                <HBox spacing="6">
                    <Button text="Thêm NV"
                            onAction="#addEmployee"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />

                    <Button text="Cập nhật"
                            onAction="#updateEmployee"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
                </HBox>

                <HBox spacing="6">
                    <Button text="Xóa"
                            onAction="#deleteEmployee"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;" />

                    <Button text="Quay lại"
                            onAction="#backToDashboard"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;" />
                </HBox>
            </VBox>

        </VBox>
    </right>

</BorderPane>
