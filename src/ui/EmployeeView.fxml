<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.EmployeeController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 16 24 16 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ NHÂN VIÊN"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Quản lý hồ sơ nhân viên, chức vụ và tiền lương"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 16;" spacing="10">
            <TableView fx:id="employeeTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60" />
                    <TableColumn fx:id="nameColumn"
                                 text="Họ tên"
                                 prefWidth="200" />
                    <TableColumn fx:id="phoneColumn"
                                 text="Số điện thoại"
                                 prefWidth="140" />
                    <TableColumn fx:id="positionColumn"
                                 text="Chức vụ"
                                 prefWidth="150" />
                    <TableColumn fx:id="salaryColumn"
                                 text="Lương (VND)"
                                 prefWidth="140" />
                    <TableColumn fx:id="userIdColumn"
                                 text="Mã người dùng"
                                 prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="14"
              prefWidth="320"
              style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">

            <Label text="Thông tin nhân viên"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

            <VBox spacing="10">
                <TextField fx:id="nameField"
                           promptText="Họ tên"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="phoneField"
                           promptText="Số điện thoại"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="positionField"
                           promptText="Chức vụ"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="salaryField"
                           promptText="Lương"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="userIdField"
                           promptText="Mã người dùng"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />
            </VBox>

            <Separator />

            <VBox spacing="10">
                <Button text="Thêm"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#addEmployee" />

                <Button text="Cập nhật"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#updateEmployee" />

                <Button text="Xóa"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#deleteEmployee" />

                <Button text="Quay lại"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#backToDashboard" />
            </VBox>
        </VBox>
    </right>

</BorderPane>
