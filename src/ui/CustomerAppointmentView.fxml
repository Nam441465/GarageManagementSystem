<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerAppointmentController">

    <top>
        <VBox spacing="8"
              alignment="CENTER"
              style="-fx-padding:20;">

            <Label text="ĐẶT LỊCH HẸN"
                   style="
                   -fx-font-size:24px;
                   -fx-font-weight:bold;" />

            <Label text="Vui lòng nhập thông tin để đặt lịch"
                   style="-fx-font-size:14px;" />

        </VBox>
    </top>


    <center>

        <VBox spacing="12"
              style="-fx-padding:20;">

            <!-- THÔNG TIN KHÁCH -->

            <Label text="Thông tin khách hàng"
                   style="-fx-font-size:17px; -fx-font-weight:bold;" />

            <TextField fx:id="customerNameField"
                       promptText="Họ và tên" />

            <TextField fx:id="phoneField"
                       promptText="Số điện thoại" />

            <!-- THÔNG TIN XE -->

            <Label text="Thông tin xe"
                   style="-fx-font-size:17px; -fx-font-weight:bold;" />

            <TextField fx:id="licensePlateField"
                       promptText="Biển số xe" />

            <ComboBox fx:id="vehicleBrandComboBox"
                      promptText="Hãng xe"
                      maxWidth="Infinity" />

            <ComboBox fx:id="vehicleTypeComboBox"
                      promptText="Loại xe"
                      maxWidth="Infinity" />

            <!-- THỜI GIAN -->

            <Label text="Thời gian đặt lịch"
                   style="-fx-font-size:17px; -fx-font-weight:bold;" />

            <DatePicker fx:id="appointmentDatePicker"
                        promptText="Ngày đặt lịch"
                        maxWidth="Infinity" />

            <ComboBox fx:id="appointmentTimeComboBox"
                      promptText="Giờ đặt lịch"
                      maxWidth="Infinity" />

            <!-- DỊCH VỤ -->

            <Label text="Chọn dịch vụ"
                   style="-fx-font-size:17px; -fx-font-weight:bold;" />

            <ScrollPane fitToWidth="true"
                        prefHeight="180">

                <content>

                    <VBox fx:id="serviceCheckBoxContainer"
                          spacing="7"
                          style="-fx-padding:8;" />

                </content>

            </ScrollPane>

        </VBox>

    </center>


    <bottom>

        <HBox spacing="15"
              alignment="CENTER"
              style="-fx-padding:20;">

            <Button text="Đặt lịch"
                    prefWidth="140"
                    prefHeight="35"
                    onAction="#createAppointment" />

            <Button text="Làm mới"
                    prefWidth="120"
                    prefHeight="35"
                    onAction="#clearFields" />

            <Button text="Quay lại"
                    prefWidth="120"
                    prefHeight="35"
                    onAction="#backToLogin" />

        </HBox>

    </bottom>

</BorderPane>