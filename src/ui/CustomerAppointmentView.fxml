<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerAppointmentController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox spacing="6"
              alignment="CENTER"
              style="-fx-background-color: #1a237e; -fx-padding: 16 25 16 25;">
            <Label text="ĐẶT LỊCH HẸN DỊCH VỤ SỬA CHỮA &amp; BẢO DƯỠNG"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
            <Label text="Vui lòng điền thông tin và lựa chọn dịch vụ để hệ thống tiếp nhận xe"
                   style="-fx-font-size: 13px; -fx-text-fill: #e8eaf6;" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-padding: 18 25 18 25;"
                  VBox.vgrow="ALWAYS">

                <GridPane hgap="25"
                          vgap="15"
                          maxWidth="Infinity"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cfd8dc;">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints percentHeight="100" />
                    </rowConstraints>

                    <!-- Cột 1: Thông tin khách hàng & xe -->
                    <VBox spacing="10"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0"
                          VBox.vgrow="ALWAYS">

                        <Label text="1. THÔNG TIN KHÁCH HÀNG"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                        <VBox spacing="4">
                            <Label text="Họ và tên:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                            <TextField fx:id="customerNameField"
                                       promptText="Nhập họ và tên khách hàng"
                                       maxWidth="Infinity"
                                       prefHeight="36"
                                       style="-fx-font-size: 13px;" />
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Số điện thoại liên hệ:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                            <TextField fx:id="phoneField"
                                       promptText="Nhập số điện thoại"
                                       maxWidth="Infinity"
                                       prefHeight="36"
                                       style="-fx-font-size: 13px;" />
                        </VBox>

                        <Label text="2. THÔNG TIN PHƯƠNG TIỆN"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-padding: 6 0 0 0;" />

                        <VBox spacing="4">
                            <Label text="Biển số xe:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                            <TextField fx:id="licensePlateField"
                                       promptText="VD: 29A-123.45"
                                       maxWidth="Infinity"
                                       prefHeight="36"
                                       style="-fx-font-size: 13px;" />
                        </VBox>

                        <HBox spacing="12" maxWidth="Infinity">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Hãng xe:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                                <ComboBox fx:id="vehicleBrandComboBox"
                                          promptText="Chọn hãng xe"
                                          maxWidth="Infinity"
                                          prefHeight="36"
                                          style="-fx-font-size: 13px;" />
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Loại xe:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                                <ComboBox fx:id="vehicleTypeComboBox"
                                          promptText="Chọn loại xe"
                                          maxWidth="Infinity"
                                          prefHeight="36"
                                          style="-fx-font-size: 13px;" />
                            </VBox>
                        </HBox>

                    </VBox>

                    <!-- Cột 2: Thời gian & Dịch vụ -->
                    <VBox spacing="10"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"
                          VBox.vgrow="ALWAYS">

                        <Label text="3. THỜI GIAN ĐẶT LỊCH"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                        <HBox spacing="12" maxWidth="Infinity">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Ngày hẹn:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                                <DatePicker fx:id="appointmentDatePicker"
                                            promptText="Chọn ngày"
                                            maxWidth="Infinity"
                                            prefHeight="36"
                                            style="-fx-font-size: 13px;" />
                            </VBox>

                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Giờ hẹn:" style="-fx-font-weight: bold; -fx-text-fill: #455a64;" />
                                <ComboBox fx:id="appointmentTimeComboBox"
                                          promptText="Chọn giờ"
                                          maxWidth="Infinity"
                                          prefHeight="36"
                                          style="-fx-font-size: 13px;" />
                            </VBox>
                        </HBox>

                        <Label text="4. CHỌN CÁC DỊCH VỤ CẦN THỰC HIỆN"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-padding: 6 0 0 0;" />

                        <ScrollPane fitToWidth="true"
                                    prefHeight="120"
                                    VBox.vgrow="ALWAYS"
                                    style="-fx-border-color: #cfd8dc; -fx-border-radius: 6;">
                            <content>
                                <VBox fx:id="serviceCheckBoxContainer"
                                      spacing="8"
                                      style="-fx-padding: 10;" />
                            </content>
                        </ScrollPane>

                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="20"
              alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 12 25 15 25; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">

            <Button text="XÁC NHẬN ĐẶT LỊCH"
                    prefWidth="200"
                    prefHeight="40"
                    style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: white; -fx-background-radius: 6;"
                    onAction="#createAppointment" />

            <Button text="Làm mới thông tin"
                    prefWidth="150"
                    prefHeight="40"
                    style="-fx-font-size: 13px; -fx-cursor: hand;"
                    onAction="#clearFields" />

            <Button text="Quay lại Trang trước"
                    prefWidth="170"
                    prefHeight="40"
                    style="-fx-font-size: 13px; -fx-cursor: hand;"
                    onAction="#backToLogin" />

        </HBox>
    </bottom>

</BorderPane>
