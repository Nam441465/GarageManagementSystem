<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VehicleController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 16 24 16 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ XE"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Quản lý danh sách phương tiện và trạng thái sửa chữa"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 16;" spacing="10">
            <TableView fx:id="vehicleTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="50" />
                    <TableColumn fx:id="customerIdColumn"
                                 text="Mã khách hàng"
                                 prefWidth="90" />
                    <TableColumn fx:id="brandColumn"
                                 text="Hãng xe"
                                 prefWidth="110" />
                    <TableColumn fx:id="vehicleTypeColumn"
                                 text="Loại xe"
                                 prefWidth="110" />
                    <TableColumn fx:id="statusColumn"
                                 text="Trạng thái"
                                 prefWidth="110" />
                    <TableColumn fx:id="licensePlateColumn"
                                 text="Biển số xe"
                                 prefWidth="120" />
                    <TableColumn fx:id="modelColumn"
                                 text="Dòng xe"
                                 prefWidth="120" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="14"
              prefWidth="320"
              style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">

            <Label text="Thông tin phương tiện"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

            <VBox spacing="10">
                <TextField fx:id="customerIdField"
                           promptText="Mã khách hàng"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <ComboBox fx:id="brandComboBox"
                          promptText="Chọn hãng xe"
                          maxWidth="Infinity"
                          prefHeight="36"
                          style="-fx-font-size: 13px;" />

                <ComboBox fx:id="vehicleTypeComboBox"
                          promptText="Chọn loại xe"
                          maxWidth="Infinity"
                          prefHeight="36"
                          style="-fx-font-size: 13px;" />

                <ComboBox fx:id="statusComboBox"
                          promptText="Chọn trạng thái"
                          maxWidth="Infinity"
                          prefHeight="36"
                          style="-fx-font-size: 13px;" />

                <TextField fx:id="licensePlateField"
                           promptText="Biển số xe"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="modelField"
                           promptText="Dòng xe"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />
            </VBox>

            <Separator />

            <VBox spacing="10">
                <Button text="Thêm"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#addVehicle" />

                <Button text="Cập nhật"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#updateVehicle" />

                <Button text="Xóa"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#deleteVehicle" />

                <Button text="Quay lại"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#backToDashboard" />
            </VBox>
        </VBox>
    </right>

</BorderPane>
