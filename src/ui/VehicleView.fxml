<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.VehicleController">

    <top>
        <Label text="Vehicle Management"/>
    </top>

    <center>

        <TableView fx:id="vehicleTable">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"/>

                <TableColumn fx:id="customerIdColumn"
                             text="Customer ID"/>

                <TableColumn fx:id="brandColumn"
                             text="Brand"/>

                <TableColumn fx:id="vehicleTypeColumn"
                             text="Vehicle Type"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"/>

                <TableColumn fx:id="licensePlateColumn"
                             text="License Plate"/>

                <TableColumn fx:id="modelColumn"
                             text="Model"/>

            </columns>

        </TableView>

    </center>

    <right>

        <VBox spacing="10">

            <TextField fx:id="customerIdField"
                       promptText="Customer ID"/>

            <TextField fx:id="brandField"
                       promptText="Brand"/>

            <TextField fx:id="vehicleTypeField"
                       promptText="Vehicle Type"/>

            <TextField fx:id="statusField"
                       promptText="Status"/>

            <TextField fx:id="licensePlateField"
                       promptText="License Plate"/>

            <TextField fx:id="modelField"
                       promptText="Model"/>

            <Button text="Add"
                    onAction="#addVehicle"/>

            <Button text="Update"
                    onAction="#updateVehicle"/>

            <Button text="Delete"
                    onAction="#deleteVehicle"/>
            <Button text="Back" onAction="#backToDashboard"/>

        </VBox>

    </right>

</BorderPane>
