<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServiceRecordController">

    <top>
        <Label text="Service Record Management"/>
    </top>

    <center>

        <TableView fx:id="serviceRecordTable">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"/>

                <TableColumn fx:id="vehicleIdColumn"
                             text="Vehicle ID"/>

                <TableColumn fx:id="recordDateColumn"
                             text="Record Date"/>

                <TableColumn fx:id="notesColumn"
                             text="Notes"/>

                <TableColumn fx:id="totalCostColumn"
                             text="Total Cost"/>

                <TableColumn fx:id="createdByColumn"
                             text="Created By"/>

            </columns>

        </TableView>

    </center>

    <right>

        <VBox spacing="10">

            <TextField fx:id="vehicleIdField"
                       promptText="Vehicle ID"/>

            <TextField fx:id="notesField"
                       promptText="Notes"/>

            <TextField fx:id="totalCostField"
                       promptText="Total Cost"/>

            <Button text="Add"
                    onAction="#addServiceRecord"/>

            <Button text="Update"
                    onAction="#updateServiceRecord"/>

            <Button text="Delete"
                    onAction="#deleteServiceRecord"/>
            <Button text="Back" onAction="#backToDashboard"/>

        </VBox>

    </right>

</BorderPane>
