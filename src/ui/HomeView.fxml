<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.HomeController"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox alignment="CENTER"
              spacing="8"
              style="-fx-background-color: #1a237e; -fx-padding: 25 30 25 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 4);">
            <Label text="GARAGE MANAGEMENT SYSTEM"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-letter-spacing: 1.5px;" />
            <Label text="HỆ THỐNG QUẢN LÝ DỊCH VỤ SỬA CHỮA &amp; BẢO DƯỠNG XE CHUYÊN NGHIỆP"
                   style="-fx-font-size: 14px; -fx-text-fill: #e8eaf6; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="25"
              style="-fx-padding: 30 40 30 40;"
              VBox.vgrow="ALWAYS">

            <Label text="CHÀO MỪNG BẠN ĐẾN VỚI HỆ THỐNG GARA"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

            <GridPane hgap="25"
                      vgap="20"
                      alignment="CENTER"
                      maxWidth="1100"
                      VBox.vgrow="ALWAYS">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" />
                    <ColumnConstraints percentWidth="33.33" />
                    <ColumnConstraints percentWidth="33.33" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="100" />
                </rowConstraints>

                <!-- Thẻ 1: Đăng nhập -->
                <VBox alignment="CENTER"
                      spacing="14"
                      GridPane.columnIndex="0"
                      style="-fx-background-color: #ffffff; -fx-padding: 30 20 30 20; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #90caf9; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="DÀNH CHO NHÂN VIÊN"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #00695c;" />
                    <Label text="ĐĂNG NHẬP HỆ THỐNG"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                    <Label text="Truy cập bảng điều khiển trung tâm để quản lý dịch vụ, khách hàng, kho và hóa đơn."
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-font-size: 13px; -fx-text-fill: #37474f;" />
                    <Button fx:id="loginButton"
                            text="ĐĂNG NHẬP NGAY"
                            maxWidth="Infinity"
                            prefHeight="42"
                            style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 6;"
                            onAction="#openLogin" />
                </VBox>

                <!-- Thẻ 2: Tra cứu -->
                <VBox alignment="CENTER"
                      spacing="14"
                      GridPane.columnIndex="1"
                      style="-fx-background-color: #ffffff; -fx-padding: 30 20 30 20; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #80cbc4; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="TRA CỨU TRỰC TUYẾN"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #00695c;" />
                    <Label text="TRA CỨU DỊCH VỤ &amp; GIÁ"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00695c;" />
                    <Label text="Xem bảng giá niêm yết theo từng hãng xe và tra cứu tiến độ sửa chữa xe tại gara."
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-font-size: 13px; -fx-text-fill: #37474f;" />
                    <Button fx:id="customerSearchButton"
                            text="TRA CỨU DỊCH VỤ"
                            maxWidth="Infinity"
                            prefHeight="42"
                            style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: #ffffff; -fx-background-radius: 6;"
                            onAction="#openCustomerLookupView" />
                </VBox>

                <!-- Thẻ 3: Đặt lịch -->
                <VBox alignment="CENTER"
                      spacing="14"
                      GridPane.columnIndex="2"
                      style="-fx-background-color: #ffffff; -fx-padding: 30 20 30 20; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #ffb74d; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <Label text="DỊCH VỤ KHÁCH HÀNG"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e65100;" />
                    <Label text="ĐẶT LỊCH HẸN BẢO DƯỠNG"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e65100;" />
                    <Label text="Đăng ký lịch hẹn sửa chữa và chọn dịch vụ trực tuyến để được tiếp nhận nhanh chóng."
                           wrapText="true"
                           textAlignment="CENTER"
                           style="-fx-font-size: 13px; -fx-text-fill: #37474f;" />
                    <Button fx:id="appointmentButton"
                            text="ĐẶT LỊCH HẸN"
                            maxWidth="Infinity"
                            prefHeight="42"
                            style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e65100; -fx-text-fill: #ffffff; -fx-background-radius: 6;"
                            onAction="#openAppointment" />
                </VBox>

            </GridPane>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-padding: 14 20 16 20; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label text="© 2026 Garage Management System - Đồ án Lập trình Hướng đối tượng"
                   style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
