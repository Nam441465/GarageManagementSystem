<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.InventoryController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ KHO PHỤ TÙNG &amp; LINH KIỆN"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Theo dõi tồn kho, giá bán và nhà cung cấp linh kiện phụ tùng thay thế"
                   style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="partTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="Mã số"
                                 prefWidth="60" />
                    <TableColumn fx:id="nameColumn"
                                 text="Tên linh kiện / Phụ tùng"
                                 prefWidth="260" />
                    <TableColumn fx:id="unitPriceColumn"
                                 text="Đơn giá (VND)"
                                 prefWidth="140" />
                    <TableColumn fx:id="stockColumn"
                                 text="Số lượng tồn"
                                 prefWidth="110" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true"
                    prefWidth="350"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
            <VBox spacing="8"
                  style="-fx-padding: 14 16 18 16;">

                <Label text="Thông tin phụ tùng"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

                <VBox spacing="5">
                    <Label text="Tên phụ tùng:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="nameField"
                               promptText="Tên phụ tùng linh kiện"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Nhà cung cấp:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="supplierField"
                               promptText="Tên nhà cung cấp"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Đơn giá (VNĐ):" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="unitPriceField"
                               promptText="Đơn giá"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Số lượng tồn kho:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextField fx:id="stockField"
                               promptText="Số lượng"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                    <Label text="Mô tả kỹ thuật:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                    <TextArea fx:id="descriptionArea"
                              promptText="Mô tả thông số kỹ thuật"
                              prefRowCount="2"
                              maxWidth="Infinity"
                              style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />
                </VBox>

                <Separator />

                <VBox spacing="6">
                    <HBox spacing="6">
                        <Button text="Thêm mới"
                                onAction="#addPart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />

                        <Button text="Cập nhật"
                                onAction="#updatePart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa"
                                onAction="#deletePart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;" />

                        <Button text="Tất cả"
                                onAction="#refreshParts"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-border-color: #9fa8da; -fx-border-radius: 4;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa trắng"
                                onAction="#clearForm"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #e8eaf6; -fx-text-fill: #1a237e; -fx-border-color: #9fa8da; -fx-border-radius: 4;" />

                        <Button text="Quay lại"
                                onAction="#backToDashboard"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
