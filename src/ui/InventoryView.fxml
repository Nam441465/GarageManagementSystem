<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.InventoryController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ KHO PHỤ TÙNG"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Quản lý tồn kho linh kiện và phụ tùng thay thế"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="partTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60" />
                    <TableColumn fx:id="nameColumn"
                                 text="Tên phụ tùng"
                                 prefWidth="260" />
                    <TableColumn fx:id="unitPriceColumn"
                                 text="Đơn giá (VND)"
                                 prefWidth="140" />
                    <TableColumn fx:id="stockColumn"
                                 text="Tồn kho"
                                 prefWidth="100" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true"
                    prefWidth="350"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
            <VBox spacing="8"
                  style="-fx-padding: 14 16 18 16;">

                <Label text="Thông tin phụ tùng"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

                <VBox spacing="6">
                    <TextField fx:id="nameField"
                               promptText="Tên phụ tùng"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <TextField fx:id="supplierField"
                               promptText="Nhà cung cấp"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <TextField fx:id="unitPriceField"
                               promptText="Đơn giá"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <TextField fx:id="stockField"
                               promptText="Số lượng tồn kho"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <TextArea fx:id="descriptionArea"
                              promptText="Mô tả"
                              prefRowCount="2"
                              maxWidth="Infinity"
                              style="-fx-font-size: 13px;" />
                </VBox>

                <Separator />

                <VBox spacing="6">
                    <HBox spacing="6">
                        <Button text="Thêm"
                                onAction="#addPart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />

                        <Button text="Cập nhật"
                                onAction="#updatePart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa"
                                onAction="#deletePart"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />

                        <Button text="Tất cả"
                                onAction="#refreshParts"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa trắng"
                                onAction="#clearForm"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />

                        <Button text="Quay lại"
                                onAction="#backToDashboard"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
