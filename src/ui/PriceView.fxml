<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.PriceController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ BẢNG GIÁ"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Bảng giá dịch vụ theo từng loại xe và hãng xe"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="priceTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60" />
                    <TableColumn fx:id="serviceColumn"
                                 text="Mã dịch vụ"
                                 prefWidth="100" />
                    <TableColumn fx:id="vehicleTypeColumn"
                                 text="Loại xe"
                                 prefWidth="120" />
                    <TableColumn fx:id="vehicleBrandColumn"
                                 text="Hãng xe"
                                 prefWidth="120" />
                    <TableColumn fx:id="priceColumn"
                                 text="Giá (VND)"
                                 prefWidth="130" />
                    <TableColumn fx:id="effectiveFromColumn"
                                 text="Hiệu lực từ"
                                 prefWidth="130" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <ScrollPane fitToWidth="true"
                    prefWidth="350"
                    style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
            <VBox spacing="10"
                  style="-fx-padding: 15 18 18 18;">

                <Label text="Thiết lập giá dịch vụ"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

                <VBox spacing="6">
                    <TextField fx:id="serviceIdField"
                               promptText="Mã dịch vụ"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <ComboBox fx:id="vehicleTypeComboBox"
                              promptText="Loại xe"
                              maxWidth="Infinity"
                              prefHeight="32"
                              style="-fx-font-size: 13px;" />

                    <ComboBox fx:id="vehicleBrandComboBox"
                              promptText="Hãng xe"
                              maxWidth="Infinity"
                              prefHeight="32"
                              style="-fx-font-size: 13px;" />

                    <TextField fx:id="priceField"
                               promptText="Giá"
                               maxWidth="Infinity"
                               prefHeight="32"
                               style="-fx-font-size: 13px;" />

                    <DatePicker fx:id="effectiveFromPicker"
                                promptText="Hiệu lực từ"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px;" />

                    <DatePicker fx:id="effectiveToPicker"
                                promptText="Hiệu lực đến (không bắt buộc)"
                                maxWidth="Infinity"
                                prefHeight="32"
                                style="-fx-font-size: 13px;" />

                    <TextArea fx:id="noteArea"
                              promptText="Ghi chú"
                              prefRowCount="2"
                              maxWidth="Infinity"
                              style="-fx-font-size: 13px;" />
                </VBox>

                <Separator />

                <VBox spacing="6">
                    <HBox spacing="6">
                        <Button text="Thêm"
                                onAction="#addPrice"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />

                        <Button text="Cập nhật"
                                onAction="#updatePrice"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />
                    </HBox>

                    <HBox spacing="6">
                        <Button text="Xóa"
                                onAction="#deletePrice"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />

                        <Button text="Xóa trắng"
                                onAction="#clearForm"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                prefHeight="34"
                                style="-fx-font-size: 13px; -fx-cursor: hand;" />
                    </HBox>

                    <Button text="Quay lại"
                            onAction="#backToDashboard"
                            maxWidth="Infinity"
                            prefHeight="34"
                            style="-fx-font-size: 13px; -fx-cursor: hand;" />
                </VBox>
            </VBox>
        </ScrollPane>
    </right>

</BorderPane>
