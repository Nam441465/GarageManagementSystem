<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 14 20 14 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ KHÁCH HÀNG"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Danh sách khách hàng và quản lý thông tin liên hệ"
                   style="-fx-font-size: 13px; -fx-text-fill: #546e7a; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 12 16 12 16;" spacing="8">
            <TableView fx:id="customerTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60" />
                    <TableColumn fx:id="nameColumn"
                                 text="Họ và tên"
                                 prefWidth="220" />
                    <TableColumn fx:id="phoneColumn"
                                 text="Số điện thoại"
                                 prefWidth="140" />
                    <TableColumn fx:id="addressColumn"
                                 text="Địa chỉ"
                                 prefWidth="280" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="10"
              prefWidth="340"
              style="-fx-background-color: #ffffff; -fx-padding: 16 20 18 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">

            <Label text="Thông tin khách hàng"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />

            <VBox spacing="6">
                <Label text="Họ và tên:" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="nameField"
                           promptText="Nhập tên khách hàng"
                           prefHeight="34"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Số điện thoại:" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="phoneField"
                           promptText="Nhập số điện thoại"
                           prefHeight="34"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />

                <Label text="Địa chỉ:" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #37474f;" />
                <TextField fx:id="addressField"
                           promptText="Nhập địa chỉ"
                           prefHeight="34"
                           style="-fx-font-size: 13px; -fx-text-fill: #263238; -fx-control-inner-background: #ffffff;" />
            </VBox>

            <Separator />

            <VBox spacing="8">
                <HBox spacing="8">
                    <Button text="Thêm mới"
                            onAction="#addCustomer"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #1a237e; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />

                    <Button text="Cập nhật"
                            onAction="#updateCustomer"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #00695c; -fx-text-fill: #ffffff; -fx-background-radius: 4;" />
                </HBox>

                <HBox spacing="8">
                    <Button text="Xóa"
                            onAction="#deleteCustomer"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-border-color: #ef9a9a; -fx-border-radius: 4;" />

                    <Button text="Quay lại"
                            onAction="#backToDashboard"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            prefHeight="36"
                            style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-color: #eceff1; -fx-text-fill: #263238; -fx-border-color: #cfd8dc; -fx-border-radius: 4;" />
                </HBox>
            </VBox>

        </VBox>
    </right>

</BorderPane>
