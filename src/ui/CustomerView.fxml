<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerController"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-padding: 16 24 16 24; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <Label text="QUẢN LÝ KHÁCH HÀNG"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
            <Label text="Quản lý danh sách khách hàng và thông tin liên hệ"
                   style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </VBox>
    </top>

    <center>
        <VBox style="-fx-padding: 16;" spacing="10">
            <TableView fx:id="customerTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-font-size: 13px;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="80" />
                    <TableColumn fx:id="nameColumn"
                                 text="Họ tên"
                                 prefWidth="220" />
                    <TableColumn fx:id="phoneColumn"
                                 text="Số điện thoại"
                                 prefWidth="160" />
                    <TableColumn fx:id="addressColumn"
                                 text="Địa chỉ"
                                 prefWidth="320" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox spacing="14"
              prefWidth="320"
              style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">

            <Label text="Thông tin khách hàng"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

            <VBox spacing="10">
                <TextField fx:id="nameField"
                           promptText="Họ tên"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="phoneField"
                           promptText="Số điện thoại"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />

                <TextField fx:id="addressField"
                           promptText="Địa chỉ"
                           maxWidth="Infinity"
                           prefHeight="36"
                           style="-fx-font-size: 13px;" />
            </VBox>

            <Separator />

            <VBox spacing="10">
                <Button text="Thêm"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#addCustomer" />

                <Button text="Cập nhật"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#updateCustomer" />

                <Button text="Xóa"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#deleteCustomer" />

                <Button text="Quay lại"
                        maxWidth="Infinity"
                        prefHeight="36"
                        style="-fx-font-size: 13px; -fx-cursor: hand;"
                        onAction="#backToDashboard" />
            </VBox>
        </VBox>
    </right>

</BorderPane>
